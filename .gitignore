# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local verification output
.tmp/

# playwright mcp session output
.playwright-mcp/

# poster composition lab: generated per-run, hashes.json is tracked
lab/out/*.svg
lab/out/index.html

# poster composition lab: previous-run snapshot for before/after diffing
lab/prev/

# poster composition lab: manual accent-palette comparison, throwaway output
lab/palette/

# stage 5: OG-image byte snapshots for before/after parity checks
lab/shots/

# stage 7.2: gallery contact sheet, regenerated by npm run gallery:check
lab/gallery/

# working notes kept outside the repository: project journal and agent rules.
# AGENTS.md is rewritten by next dev on every run, so it has to stay ignored
# rather than simply deleted. docs/ itself is tracked - it holds the README
# screenshots - so only the journal is named here.
AGENTS.md
CLAUDE.md
docs/handoff.md

# local scrap folder, never part of the project
_emquad-scrap/
