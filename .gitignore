# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local verification output
.tmp/

# playwright mcp session output
.playwright-mcp/

# poster composition lab: generated per-run, hashes.json is tracked
lab/out/*.svg
lab/out/index.html

# poster composition lab: previous-run snapshot for before/after diffing
lab/prev/

# stage 5: OG-image byte snapshots for before/after parity checks
lab/shots/

